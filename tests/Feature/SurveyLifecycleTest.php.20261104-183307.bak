<?php
namespace Tests\Feature;use App\Models\{Floor,FloorPlan,Institution,Survey,User};use Database\Seeders\RolesAndPermissionsSeeder;use Illuminate\Foundation\Testing\RefreshDatabase;use Tests\TestCase;
class SurveyLifecycleTest extends TestCase{use RefreshDatabase;protected function setUp():void{parent::setUp();$this->seed(RolesAndPermissionsSeeder::class);}private function setup():array{$u=User::factory()->create();$u->assignRole('Network Admin');$i=Institution::create(['name'=>'Test','slug'=>'test']);$c=$i->campuses()->create(['name'=>'Main','code'=>'M']);$b=$c->buildings()->create(['name'=>'Library','code'=>'L']);$f=$b->floors()->create(['name'=>'Ground','code'=>'G','level_number'=>0]);$p=$f->floorPlans()->create(['uploaded_by'=>$u->id,'original_name'=>'p.png','file_path'=>'p','mime_type'=>'image/png','file_size'=>1,'original_width'=>1000,'original_height'=>800,'pixels_per_metre'=>50,'usable_boundary'=>[['x'=>0,'y'=>0],['x'=>1,'y'=>0],['x'=>1,'y'=>1]],'version'=>1,'is_active'=>true]);return[$u,$f,$p];}public function test_admin_can_create_and_start_survey():void{[$u,$f,$p]=$this->setup();$res=$this->actingAs($u)->postJson('/api/surveys',['floor_id'=>$f->id,'floor_plan_id'=>$p->id,'name'=>'Baseline','purpose'=>'coverage_baseline','minimum_points'=>3])->assertCreated();$id=$res->json('id');$this->postJson("/api/surveys/$id/start")->assertCreated()->assertJson(['status'=>'collecting']);$this->assertDatabaseHas('surveys',['id'=>$id,'status'=>'collecting']);}public function test_measurement_coordinates_are_validated():void{[$u,$f,$p]=$this->setup();$s=Survey::create(['floor_id'=>$f->id,'floor_plan_id'=>$p->id,'created_by'=>$u->id,'name'=>'Test']);$this->actingAs($u)->postJson("/api/surveys/{$s->id}/points",['x_normalized'=>1.4,'y_normalized'=>.5,'source_type'=>'measured','collection_method'=>'manual'])->assertUnprocessable()->assertJsonValidationErrors('x_normalized');}public function test_survey_cannot_complete_without_minimum_valid_points():void{[$u,$f,$p]=$this->setup();$s=Survey::create(['floor_id'=>$f->id,'floor_plan_id'=>$p->id,'created_by'=>$u->id,'name'=>'Test','minimum_points'=>3]);$this->actingAs($u)->postJson("/api/surveys/{$s->id}/complete")->assertUnprocessable();}}
