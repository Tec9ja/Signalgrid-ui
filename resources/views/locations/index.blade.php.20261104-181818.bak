<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Locations | SignalGrid</title>@vite(['resources/css/app.css','resources/css/signalgrid.css','resources/js/app.js'])</head><body class="domain-body"><main class="domain-shell"><header class="domain-header"><div><span class="eyebrow">CAMPUS STRUCTURE</span><h1>Location hierarchy</h1><p>Campus → Building → Floor → Survey Area</p></div><a class="secondary" href="{{ route('dashboard') }}">Back to dashboard</a></header>@forelse($institutions as $institution)<section class="panel domain-card"><h2>{{ $institution->name }}</h2><p>{{ $institution->type }} · {{ $institution->timezone }}</p>@foreach($institution->campuses as $campus)<details open><summary><b>{{ $campus->name }}</b><span>{{ $campus->buildings->count() }} buildings</span></summary><div class="domain-grid">@foreach($campus->buildings as $building)<article><h3>{{ $building->name }}</h3><small>{{ $building->code }}</small>@foreach($building->floors as $floor)<div class="floor-row"><div><b>{{ $floor->name }}</b><small>{{ $floor->surveyAreas->count() }} survey areas · {{ $floor->activeFloorPlan ? 'Floor plan ready' : 'No floor plan' }}</small></div><span>Level {{ $floor->level_number }}</span></div>@endforeach</article>@endforeach</div></details>@endforeach</section>@empty<section class="panel domain-empty"><h2>No locations yet</h2><p>Run the Phase 3 seeder or create the first institution.</p></section>@endforelse</main></body></html>