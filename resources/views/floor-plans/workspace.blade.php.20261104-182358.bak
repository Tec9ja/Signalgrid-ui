<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="csrf-token" content="{{ csrf_token() }}"><title>Floor Plan | SignalGrid</title>@vite('resources/js/app.js')</head><body class="domain-body"><main class="fp-shell"><header class="fp-header"><div><span class="eyebrow">FLOOR-PLAN MANAGEMENT</span><h1>{{ $floor->building->name }} · {{ $floor->name }}</h1><p>{{ $floor->building->campus->institution->name }} / {{ $floor->building->campus->name }}</p></div><div><a class="secondary" href="{{ route('locations.index') }}">Locations</a><a class="primary" href="{{ route('dashboard') }}">Dashboard</a></div></header><div class="fp-grid"><aside class="panel fp-sidebar"><h3>Floor plan versions</h3><form id="uploadForm" enctype="multipart/form-data"><label class="fp-upload"><input type="file" name="floor_plan" accept="image/png,image/jpeg,application/pdf" required><b>Choose floor plan</b><span>PNG, JPG or PDF · 20 MB maximum</span></label><button class="primary full" type="submit">Upload new version</button></form><div class="fp-versions">@forelse($floor->floorPlans as $plan)<button type="button" data-plan='@json($plan)' data-file="{{ route('floor-plans.file',$plan) }}" class="fp-version {{ $plan->is_active?'active':'' }}"><span><b>Version {{ $plan->version }}</b><small>{{ $plan->original_name }}</small></span><em>{{ $plan->is_active?'Active':'Previous' }}</em></button>@empty<p class="fp-empty">No floor-plan version uploaded.</p>@endforelse</div></aside><section class="panel fp-workspace"><div class="fp-toolbar"><button type="button" id="zoomOut">−</button><strong id="zoomLabel">100%</strong><button type="button" id="zoomIn">+</button><button type="button" id="resetView">Reset</button><span id="workspaceStatus">Select or upload a floor plan</span></div><div class="fp-canvas" id="fpCanvas"><div class="fp-placeholder"><b>Floor-plan workspace</b><span>Upload an image, then select two calibration points.</span></div><img id="fpImage" alt="Selected floor plan" hidden><div id="calibrationLine" hidden><i id="pointA"></i><i id="pointB"></i><b></b></div></div></section><aside class="panel fp-controls"><h3>Calibration</h3><p>Select two points on the image with a known real-world distance.</p><ol><li>Click point A</li><li>Click point B</li><li>Enter distance in metres</li></ol><label>Known distance<input id="distanceMetres" type="number" min="0.1" step="0.01" placeholder="Example: 10"></label><button class="primary full" id="saveCalibration" type="button">Save calibration</button><div class="fp-result"><span>Pixels per metre</span><b id="ppmValue">Not calibrated</b></div><hr><h3>Usable boundary</h3><p>Boundary drawing will use normalized coordinates and exclude non-surveyed image areas.</p><button class="secondary full" id="boundaryMode" type="button">Start boundary drawing</button><button class="secondary full" id="saveBoundary" type="button" disabled>Save boundary</button><p id="message" class="fp-message"></p></aside></div></main><script>window.floorPlanConfig={floorId:{{ $floor->id }},uploadUrl:@json(route('floor-plans.store',$floor)),csrf:@json(csrf_token())};</script></body></html>