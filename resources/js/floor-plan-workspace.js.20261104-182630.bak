const cfg=window.floorPlanConfig;if(cfg){const $=s=>document.querySelector(s),canvas=$('#fpCanvas'),img=$('#fpImage'),line=$('#calibrationLine'),msg=$('#message');let plan=null,clicks=[],scale=1,boundaryMode=false,boundary=[];const request=async(url,options={})=>{const res=await fetch(url,{...options,headers:{'X-CSRF-TOKEN':cfg.csrf,'Accept':'application/json',...(options.headers||{})}});const data=res.status===204?null:await res.json();if(!res.ok)throw new Error(data?.message||Object.values(data?.errors||{})[0]?.[0]||'Request failed');return data};document.querySelectorAll('.fp-version').forEach(b=>b.onclick=()=>{document.querySelectorAll('.fp-version').forEach(x=>x.classList.remove('selected'));b.classList.add('selected');plan=JSON.parse(b.dataset.plan);img.src=b.dataset.file;img.hidden=false;$('.fp-placeholder').hidden=true;$('#ppmValue').textContent=plan.pixels_per_metre?Number(plan.pixels_per_metre).toFixed(2):'Not calibrated';clicks=[];line.hidden=true;msg.textContent='Version '+plan.version+' selected.'});$('#uploadForm').onsubmit=async e=>{e.preventDefault();try{msg.textContent='Uploading...';await request(cfg.uploadUrl,{method:'POST',body:new FormData(e.target)});location.reload()}catch(x){msg.textContent=x.message}};const point=e=>{if(!plan||img.hidden)return;const r=img.getBoundingClientRect(),p={x:(e.clientX-r.left)/r.width,y:(e.clientY-r.top)/r.height};if(boundaryMode){boundary.push(p);const dot=document.createElement('span');dot.className='boundary-dot';dot.style.left=(p.x*100)+'%';dot.style.top=(p.y*100)+'%';canvas.appendChild(dot);$('#saveBoundary').disabled=boundary.length<3;return}clicks.push(p);if(clicks.length>2)clicks=[p];line.hidden=clicks.length<1;$('#pointA').style.left=(clicks[0].x*100)+'%';$('#pointA').style.top=(clicks[0].y*100)+'%';if(clicks[1]){$('#pointB').style.left=(clicks[1].x*100)+'%';$('#pointB').style.top=(clicks[1].y*100)+'%';line.querySelector('b').style.setProperty('--x1',(clicks[0].x*100)+'%');line.querySelector('b').style.setProperty('--y1',(clicks[0].y*100)+'%');line.querySelector('b').style.setProperty('--x2',(clicks[1].x*100)+'%');line.querySelector('b').style.setProperty('--y2',(clicks[1].y*100)+'%')}};canvas.onclick=point;$('#saveCalibration').onclick=async()=>{if(!plan||clicks.length!==2){msg.textContent='Select two calibration points first.';return}try{const d=await request(`/api/floor-plans/${plan.id}/calibrate`,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({x1:clicks[0].x,y1:clicks[0].y,x2:clicks[1].x,y2:clicks[1].y,distance_metres:Number($('#distanceMetres').value)})});$('#ppmValue').textContent=Number(d.pixels_per_metre).toFixed(2);msg.textContent='Calibration saved.'}catch(x){msg.textContent=x.message}};$('#boundaryMode').onclick=()=>{boundaryMode=!boundaryMode;boundary=[];document.querySelectorAll('.boundary-dot').forEach(x=>x.remove());$('#boundaryMode').textContent=boundaryMode?'Boundary mode active':'Start boundary drawing';$('#saveBoundary').disabled=true};$('#saveBoundary').onclick=async()=>{try{await request(`/api/floor-plans/${plan.id}/boundary`,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({points:boundary})});msg.textContent='Usable boundary saved.';boundaryMode=false}catch(x){msg.textContent=x.message}};const zoom=d=>{scale=Math.max(.5,Math.min(2.5,scale+d));img.style.transform=`scale(${scale})`;$('#zoomLabel').textContent=Math.round(scale*100)+'%'};$('#zoomIn').onclick=()=>zoom(.1);$('#zoomOut').onclick=()=>zoom(-.1);$('#resetView').onclick=()=>{scale=1;img.style.transform='scale(1)';$('#zoomLabel').textContent='100%'}}}