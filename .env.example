APP_NAME=SignalGrid
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Floor plans, imported CSVs and report files stay available after a restart
# only when these are set. Leave them blank for local development.
# FILESYSTEM_DISK stays local. For Cloudflare R2, also set AWS_ENDPOINT
# and AWS_USE_PATH_STYLE_ENDPOINT=true.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# AWS_ENDPOINT=

VITE_APP_NAME="${APP_NAME}"

# First Super Admin. Leave both the email and the password blank to skip
# automatic account creation. An existing account with this email keeps its
# password. Never commit the filled-in .env file.
SIGNALGRID_ADMIN_NAME=
SIGNALGRID_ADMIN_EMAIL=
SIGNALGRID_ADMIN_PASSWORD=

# Published site. Set these in the Vercel project. Do not put real values in git.
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-project.vercel.app
# LOG_CHANNEL=stderr
# DB_CONNECTION=pgsql
# DB_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# DB_SSLMODE=require
# SESSION_DRIVER=database
# CACHE_STORE=database
# QUEUE_CONNECTION=sync
# FILESYSTEM_DISK=local
