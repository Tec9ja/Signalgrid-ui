<?php
namespace App\Services;use App\Models\MeasurementImport;use Illuminate\Support\Facades\DB;use Illuminate\Support\Facades\Storage;use Throwable;
class CsvMeasurementImportService{private array $required=['x_normalized','y_normalized','rssi_dbm','captured_at'];public function process(MeasurementImport $import,int $userId):MeasurementImport{$import->update(['status'=>'processing']);$handle=fopen(Storage::disk('local')->path($import->file_path),'r');$headers=array_map(fn($h)=>strtolower(trim($h)),fgetcsv($handle)?:[]);$missing=array_diff($this->required,$headers);if($missing){$import->update(['status'=>'failed','error_message'=>'Missing columns: '.implode(', ',$missing)]);return $import->refresh();}$row=1;$ok=0;$bad=0;while(($values=fgetcsv($handle))!==false){$row++;$data=array_combine($headers,array_pad($values,count($headers),null));$errors=[];foreach(['x_normalized','y_normalized'] as $k)if(!is_numeric($data[$k])||$data[$k]<0||$data[$k]>1)$errors[]="$k must be between 0 and 1";if(!is_numeric($data['rssi_dbm'])||$data['rssi_dbm']<-120||$data['rssi_dbm']>0)$errors[]='rssi_dbm must be between -120 and 0';if(strtotime((string)$data['captured_at'])===false)$errors[]='captured_at is invalid';if($errors){$import->errors()->create(['row_number'=>$row,'row_data'=>$data,'errors'=>$errors]);$bad++;continue;}try{DB::transaction(function()use($import,$userId,$data){$p=$import->survey->points()->create(['floor_plan_id'=>$import->survey->floor_plan_id,'survey_area_id'=>$import->survey->survey_area_id,'captured_by'=>$userId,'x_normalized'=>$data['x_normalized'],'y_normalized'=>$data['y_normalized'],'source_type'=>'imported','collection_method'=>'csv','validation_status'=>'valid','captured_at'=>$data['captured_at']]);$p->measurements()->create(['measurement_import_id'=>$import->id,'ssid'=>$data['ssid']??null,'bssid_hash'=>empty($data['bssid'])?null:hash('sha256',strtolower($data['bssid'])),'rssi_dbm'=>$data['rssi_dbm'],'download_mbps'=>$data['download_mbps']?:null,'upload_mbps'=>$data['upload_mbps']?:null,'latency_ms'=>$data['latency_ms']?:null,'jitter_ms'=>$data['jitter_ms']?:null,'packet_loss_percent'=>$data['packet_loss_percent']?:null,'channel'=>$data['channel']?:null,'frequency_band'=>$data['frequency_band']?:null,'source_type'=>'imported','collection_method'=>'csv','is_simulated'=>false,'captured_at'=>$data['captured_at'],'raw_payload'=>$data]);});$ok++;}catch(Throwable $e){$import->errors()->create(['row_number'=>$row,'row_data'=>$data,'errors'=>[$e->getMessage()]]);$bad++;}}fclose($handle);$import->update(['status'=>'completed','total_rows'=>$ok+$bad,'accepted_rows'=>$ok,'rejected_rows'=>$bad,'processed_at'=>now()]);return $import->refresh();}}
